<Window x:Class="Ppinpix.Pin.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SizeToContent="WidthAndHeight">
    <Grid x:Name="OuterGrid" Margin="0">
        <!-- 正常图片/文字贴图态 -->
        <Border x:Name="CardBorder"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="#40FFFFFF"
                Background="#FF16191E"
                SnapsToDevicePixels="True">
            <Grid x:Name="ImageHost" ClipToBounds="True">
                <Image x:Name="PinImage"
                       Stretch="Fill"
                       SnapsToDevicePixels="True" />

                <!-- 静默 OCR 字符选区层（与显示等尺寸同源叠加） -->
                <ContentPresenter x:Name="TextLayerHost" />

                <!-- 缩放 / 透明度 / 状态角标（800ms 自动淡出） -->
                <Border x:Name="StatusBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="6"
                        Padding="7,3"
                        CornerRadius="4"
                        Background="#EB1F2329"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="StatusBadgeText"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="11.5"
                               Foreground="#FFF2F4F7" />
                </Border>

                <!-- 原位翻译进度 / 原图对比提示角标 -->
                <Border x:Name="TranslateBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="6"
                        Padding="7,3"
                        CornerRadius="4"
                        Background="#EB1F2329"
                        BorderBrush="#552F80FF"
                        BorderThickness="1"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TranslateBadgeText"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="11"
                                   Foreground="#FFF2F4F7"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="TranslateStopBtn"
                                Content="停止"
                                Margin="6,0,0,0"
                                Padding="5,1"
                                FontSize="10.5"
                                Background="#FF9E2B25"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="OnTranslateStopClick" />
                    </StackPanel>
                </Border>

                <!-- 鼠标穿透提示角标（穿透启用时常显右上/左下角） -->
                <Border x:Name="ClickThroughBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="5"
                        Padding="6,2"
                        CornerRadius="4"
                        Background="#CC1F2329"
                        BorderBrush="#552F80FF"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="ClickThroughBadgeText"
                               Text="鼠标穿透 · Ctrl+Alt 可移动"
                               FontSize="10.5"
                               Foreground="#FF8FB8FF" />
                </Border>

                <!-- F2 内联改名框 -->
                <TextBox x:Name="RenameBox"
                         Visibility="Collapsed"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Left"
                         Margin="6"
                         MinWidth="130"
                         Padding="6,3"
                         FontSize="12"
                         Foreground="#FFF2F4F7"
                         Background="#F01F2329"
                         BorderBrush="#FF2F80FF"
                         BorderThickness="1" />
            </Grid>
        </Border>

        <!-- 双击折叠后的 160x28 紧凑胶囊栏 -->
        <Border x:Name="CollapsedBar"
                Visibility="Collapsed"
                Width="160"
                Height="28"
                CornerRadius="6"
                Background="#F21F2329"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="8,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="双击展开"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           FontSize="10"
                           Foreground="#FFA3ABB8" />
                <TextBlock x:Name="CollapsedTitleText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="#FFF2F4F7" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
