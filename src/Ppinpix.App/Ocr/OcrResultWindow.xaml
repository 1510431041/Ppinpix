<Window x:Class="Ppinpix.App.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字识别 — Ppinpix"
        Width="440"
        Height="500"
        MinWidth="340"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#FF1F2329"
        Foreground="#FFF2F4F7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：识别状态 + 复制 + 去翻译 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="TranslateBtn"
                        Content="翻译"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        Background="#FF2A2F37"
                        Foreground="#FFF2F4F7"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnTranslateClick" />
                <Button x:Name="CopyAllBtn"
                        Content="复制全部"
                        Padding="14,5"
                        Background="#FF2F80FF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OnCopyAllClick" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#FFA3ABB8"
                       FontSize="12"
                       Text="正在离线识别文字…" />
        </DockPanel>

        <!-- 二维码 / 条形码检测结果卡片 -->
        <Border x:Name="BarcodePanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Margin="0,0,0,10"
                Padding="10"
                CornerRadius="6"
                Background="#FF2A2F37"
                BorderBrush="#402F80FF"
                BorderThickness="1">
            <StackPanel x:Name="BarcodeList" />
        </Border>

        <!-- 识别全文（可自由修改与复制） -->
        <Border Grid.Row="2"
                CornerRadius="6"
                Background="#FF16191E"
                BorderBrush="#26FFFFFF"
                BorderThickness="1">
            <TextBox x:Name="ResultTextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="#FFF2F4F7"
                     CaretBrush="#FFF2F4F7"
                     BorderThickness="0"
                     Padding="12"
                     FontSize="13.5"
                     TextChanged="OnResultTextChanged" />
        </Border>

        <!-- 底部统计 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right"
                       Foreground="#FF7E8694"
                       FontSize="11.5"
                       Text="Esc 关闭 · 完全离线识别" />
            <TextBlock x:Name="StatsText"
                       Foreground="#FFA3ABB8"
                       FontSize="11.5"
                       Text="0 字 · 0 行" />
        </DockPanel>
    </Grid>
</Window>
