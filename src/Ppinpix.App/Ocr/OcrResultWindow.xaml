<Window x:Class="Ppinpix.App.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字识别 — Ppinpix"
        Width="460"
        Height="520"
        MinWidth="360"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Pp.Settings.WindowBg}"
        Foreground="{DynamicResource Pp.Settings.TextPrimary}"
        FontFamily="{DynamicResource Pp.UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ppinpix.Theme;component/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：识别状态 + 翻译 + 复制全部 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="TranslateBtn"
                        Content="翻译"
                        Margin="0,0,8,0"
                        Click="OnTranslateClick" />
                <Button x:Name="CopyAllBtn"
                        Content="复制全部"
                        Padding="18,0"
                        Style="{StaticResource Pp.Button.Primary}"
                        Click="OnCopyAllClick" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"
                       FontSize="12"
                       Foreground="{DynamicResource Pp.Settings.TextSecondary}"
                       Text="正在离线识别文字…" />
        </DockPanel>

        <!-- 二维码 / 条形码检测结果卡片 -->
        <Border x:Name="BarcodePanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Margin="0,0,0,12"
                Padding="12"
                Style="{StaticResource Pp.Card}">
            <StackPanel x:Name="BarcodeList" />
        </Border>

        <!-- 识别全文（可自由修改与复制） -->
        <Border Grid.Row="2" Margin="0" Style="{StaticResource Pp.Card}">
            <TextBox x:Name="ResultTextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Top"
                     Padding="12"
                     FontSize="13.5"
                     TextChanged="OnResultTextChanged" />
        </Border>

        <!-- 底部统计 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Right"
                       Foreground="{DynamicResource Pp.Settings.TextSecondary}"
                       FontSize="12"
                       Text="Esc 关闭 · 完全离线识别" />
            <TextBlock x:Name="StatsText"
                       Foreground="{DynamicResource Pp.Settings.TextSecondary}"
                       FontSize="12"
                       Text="0 字 · 0 行" />
        </DockPanel>
    </Grid>
</Window>
