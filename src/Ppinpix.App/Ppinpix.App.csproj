<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Ppinpix.App</RootNamespace>
    <AssemblyName>Ppinpix</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ppinpix.Core\Ppinpix.Core.csproj" />
    <ProjectReference Include="..\Ppinpix.Theme\Ppinpix.Theme.csproj" />
    <ProjectReference Include="..\Ppinpix.Capture\Ppinpix.Capture.csproj" />
    <ProjectReference Include="..\Ppinpix.Pin\Ppinpix.Pin.csproj" />
    <ProjectReference Include="..\Ppinpix.Ocr\Ppinpix.Ocr.csproj" />
    <ProjectReference Include="..\Ppinpix.LlmGateway\Ppinpix.LlmGateway.csproj" />
    <ProjectReference Include="..\Ppinpix.Translate\Ppinpix.Translate.csproj" />
  </ItemGroup>
</Project>
