<Window x:Class="Ppinpix.App.Translate.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图翻译 — Ppinpix"
        Width="440"
        Height="560"
        MinWidth="320"
        MaxWidth="780"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#FF1F2329"
        Foreground="#FFF2F4F7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 第 1 行：配置选择 + 输入方式 + 设置按钮 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenSettingsBtn"
                        Content="接口设置"
                        Padding="10,4"
                        Background="#FF2A2F37"
                        Foreground="#FFA3ABB8"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnOpenSettingsClick" />
            </StackPanel>

            <ComboBox x:Name="ProfileCombo"
                      Margin="0,0,8,0"
                      Padding="8,4"
                      SelectionChanged="OnProfileChanged" />
        </DockPanel>

        <!-- 第 2 行：语种选择 + 视图切换（对照文本 / 原位覆盖译图） -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="InputModeBtn"
                        Content="OCR 文字"
                        Padding="8,4"
                        Margin="6,0,6,0"
                        Background="#FF2A2F37"
                        Foreground="#FFF2F4F7"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnToggleInputModeClick" />
                <Button x:Name="OverlayModeBtn"
                        Content="原位覆盖"
                        Padding="9,4"
                        Background="#FF2A2F37"
                        Foreground="#FFF2F4F7"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnOverlayTranslateClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="SourceLangCombo" Width="96" Padding="6,4" />
                <TextBlock Text=" → " VerticalAlignment="Center" Foreground="#FFA3ABB8" Margin="4,0" />
                <ComboBox x:Name="TargetLangCombo" Width="96" Padding="6,4" SelectionChanged="OnTargetLangChanged" />
            </StackPanel>
        </DockPanel>

        <!-- 第 3 行：文本对照面板 OR 原位渲染对比预览图 -->
        <Grid Grid.Row="2">
            <!-- 对照视图 -->
            <Grid x:Name="CompareView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="90" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- 原文区（可手动修改并 Ctrl+Enter 重译） -->
                <Border Grid.Row="0"
                        CornerRadius="6"
                        Background="#FF16191E"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="10,6,8,4">
                            <Button DockPanel.Dock="Right"
                                    Content="复制原文"
                                    Padding="7,2"
                                    FontSize="11"
                                    Background="Transparent"
                                    Foreground="#FFA3ABB8"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="OnCopySourceClick" />
                            <Button DockPanel.Dock="Right"
                                    x:Name="RetranslateBtn"
                                    Content="重新翻译 (Ctrl+Enter)"
                                    Padding="8,2"
                                    Margin="0,0,6,0"
                                    FontSize="11"
                                    Background="#302F80FF"
                                    Foreground="#FF8FB8FF"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="OnRetranslateClick" />
                            <TextBlock x:Name="SourceLabel"
                                       Text="原文"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="#FFA3ABB8" />
                        </DockPanel>
                        <TextBox x:Name="SourceTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 Foreground="#FFE2E6EC"
                                 CaretBrush="#FFF2F4F7"
                                 BorderThickness="0"
                                 Padding="10,4,10,8"
                                 FontSize="13"
                                 PreviewKeyDown="OnSourcePreviewKeyDown" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="8"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeNS" />

                <!-- 译文流式展示区 -->
                <Border Grid.Row="2"
                        CornerRadius="6"
                        Background="#FF16191E"
                        BorderBrush="#332F80FF"
                        BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="10,6,8,4">
                            <Button DockPanel.Dock="Right"
                                    x:Name="CopyTargetBtn"
                                    Content="复制译文"
                                    Padding="9,2"
                                    FontSize="11.5"
                                    Background="#FF2F80FF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="OnCopyTargetClick" />
                            <Button DockPanel.Dock="Right"
                                    x:Name="StopBtn"
                                    Content="停止"
                                    Padding="9,2"
                                    Margin="0,0,6,0"
                                    FontSize="11.5"
                                    Visibility="Collapsed"
                                    Background="#FF9E2B25"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="OnStopClick" />
                            <TextBlock x:Name="TargetLabel"
                                       Text="译文"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="#FF8FB8FF" />
                        </DockPanel>
                        <TextBox x:Name="TargetTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 Foreground="#FFF2F4F7"
                                 BorderThickness="0"
                                 Padding="10,4,10,8"
                                 FontSize="13.5" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 原位译图渲染与 Alt 按住对比视图 -->
            <Border x:Name="OverlayPreviewView"
                    Visibility="Collapsed"
                    CornerRadius="6"
                    Background="#FF16191E"
                    BorderBrush="#332F80FF"
                    BorderThickness="1"
                    Padding="8">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="固定到屏幕贴图"
                                Padding="10,4"
                                Margin="6,0,0,0"
                                Background="#FF2F80FF"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnPinOverlayImageClick" />
                        <Button DockPanel.Dock="Right"
                                Content="复制译图"
                                Padding="10,4"
                                Margin="6,0,0,0"
                                Background="#FF2A2F37"
                                Foreground="#FFF2F4F7"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnCopyOverlayImageClick" />
                        <Button DockPanel.Dock="Right"
                                Content="返回文本对照"
                                Padding="10,4"
                                Background="Transparent"
                                Foreground="#FFA3ABB8"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnBackToCompareClick" />
                        <TextBlock x:Name="OverlayHintText"
                                   Text="按住 Alt 查看原图对比"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#FFA3ABB8" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="OverlayPreviewImage" Stretch="Uniform" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 第 4 行：状态栏与延迟信息 / 错误提示 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    x:Name="RetryBtn"
                    Content="重试"
                    Visibility="Collapsed"
                    Padding="10,2"
                    Background="#FF2A2F37"
                    Foreground="#FFF2F4F7"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnRetranslateClick" />
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11.5"
                       Foreground="#FFA3ABB8" />
        </DockPanel>
    </Grid>
</Window>
