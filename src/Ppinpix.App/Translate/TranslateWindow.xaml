<Window x:Class="Ppinpix.App.Translate.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图翻译 — Ppinpix"
        Width="460"
        Height="580"
        MinWidth="340"
        MaxWidth="780"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Pp.Settings.WindowBg}"
        Foreground="{DynamicResource Pp.Settings.TextPrimary}"
        FontFamily="{DynamicResource Pp.UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ppinpix.Theme;component/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 第 1 行：配置选择 + 接口设置 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <Button x:Name="OpenSettingsBtn"
                    DockPanel.Dock="Right"
                    Content="接口设置"
                    Style="{StaticResource Pp.Button.Ghost}"
                    Click="OnOpenSettingsClick" />
            <ComboBox x:Name="ProfileCombo"
                      Margin="0,0,8,0"
                      SelectionChanged="OnProfileChanged" />
        </DockPanel>

        <!-- 第 2 行：语种选择 + 输入方式 / 视图切换 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="InputModeBtn"
                        Content="OCR 文字"
                        Margin="8,0,8,0"
                        Click="OnToggleInputModeClick" />
                <Button x:Name="OverlayModeBtn"
                        Content="原位覆盖"
                        Click="OnOverlayTranslateClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="SourceLangCombo" Width="104" />
                <TextBlock Text="→"
                           VerticalAlignment="Center"
                           Margin="10,0"
                           Foreground="{DynamicResource Pp.Settings.TextSecondary}" />
                <ComboBox x:Name="TargetLangCombo" Width="104" SelectionChanged="OnTargetLangChanged" />
            </StackPanel>
        </DockPanel>

        <!-- 第 3 行：文本对照面板 OR 原位渲染对比预览图 -->
        <Grid Grid.Row="2">
            <!-- 对照视图 -->
            <Grid x:Name="CompareView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="96" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5*" MinHeight="128" />
                </Grid.RowDefinitions>

                <!-- 原文区（可手动修改并 Ctrl+Enter 重译） -->
                <Border Grid.Row="0" Margin="0" Style="{StaticResource Pp.Card}">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="14,8,8,0">
                            <Button DockPanel.Dock="Right"
                                    Content="复制原文"
                                    Style="{StaticResource Pp.Button.Ghost}"
                                    Click="OnCopySourceClick" />
                            <Button x:Name="RetranslateBtn"
                                    DockPanel.Dock="Right"
                                    Content="重新翻译 (Ctrl+Enter)"
                                    Style="{StaticResource Pp.Button.Ghost}"
                                    Foreground="{DynamicResource Pp.Accent}"
                                    Click="OnRetranslateClick" />
                            <TextBlock x:Name="SourceLabel"
                                       Text="原文"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Pp.Settings.TextSecondary}" />
                        </DockPanel>
                        <TextBox x:Name="SourceTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Top"
                                 Padding="12,4,12,10"
                                 PreviewKeyDown="OnSourcePreviewKeyDown" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="12"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeNS" />

                <!-- 译文流式展示区 -->
                <Border Grid.Row="2" Margin="0" Style="{StaticResource Pp.Card}">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="14,8,8,0">
                            <Button x:Name="CopyTargetBtn"
                                    DockPanel.Dock="Right"
                                    Content="复制译文"
                                    MinHeight="28"
                                    Padding="14,0"
                                    FontSize="12"
                                    Style="{StaticResource Pp.Button.Primary}"
                                    Click="OnCopyTargetClick" />
                            <Button x:Name="StopBtn"
                                    DockPanel.Dock="Right"
                                    Content="停止"
                                    Margin="0,0,8,0"
                                    MinHeight="28"
                                    Padding="14,0"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    Style="{StaticResource Pp.Button.Danger}"
                                    Click="OnStopClick" />
                            <TextBlock x:Name="TargetLabel"
                                       Text="译文"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Pp.Accent}" />
                        </DockPanel>
                        <TextBox x:Name="TargetTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Top"
                                 Padding="12,4,12,10"
                                 FontSize="13.5" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 原位译图渲染与 Alt 按住对比视图 -->
            <Border x:Name="OverlayPreviewView"
                    Visibility="Collapsed"
                    Margin="0"
                    Padding="10"
                    Style="{StaticResource Pp.Card}">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="固定到屏幕"
                                Margin="8,0,0,0"
                                Style="{StaticResource Pp.Button.Primary}"
                                Click="OnPinOverlayImageClick" />
                        <Button DockPanel.Dock="Right"
                                Content="复制译图"
                                Margin="8,0,0,0"
                                Click="OnCopyOverlayImageClick" />
                        <Button DockPanel.Dock="Right"
                                Content="返回文本对照"
                                Style="{StaticResource Pp.Button.Ghost}"
                                Click="OnBackToCompareClick" />
                        <TextBlock x:Name="OverlayHintText"
                                   Text="按住 Alt 查看原图对比"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Pp.Settings.TextSecondary}" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="OverlayPreviewImage" Stretch="Uniform" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 第 4 行：状态栏与延迟信息 / 错误提示 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
            <Button x:Name="RetryBtn"
                    DockPanel.Dock="Right"
                    Content="重试"
                    Visibility="Collapsed"
                    MinHeight="28"
                    Padding="14,0"
                    FontSize="12"
                    Click="OnRetranslateClick" />
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12"
                       Foreground="{DynamicResource Pp.Settings.TextSecondary}" />
        </DockPanel>
    </Grid>
</Window>
