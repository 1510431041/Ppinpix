<Window x:Class="Ppinpix.App.Translate.PrivacyDisclosureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次翻译隐私告知 — Ppinpix"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1F2329"
        Foreground="#FFF2F4F7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="即将向您配置的第三方大模型接口发送数据"
                   FontSize="15.5"
                   FontWeight="SemiBold"
                   Foreground="#FFF2F4F7"
                   Margin="0,0,0,10" />

        <Border Padding="12"
                CornerRadius="6"
                Background="#FF16191E"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="EndpointSummary"
                           TextWrapping="Wrap"
                           Foreground="#FF8FB8FF"
                           FontSize="12.5"
                           Margin="0,0,0,6" />
                <TextBlock x:Name="PayloadScope"
                           TextWrapping="Wrap"
                           Foreground="#FFA3ABB8"
                           FontSize="12.5"
                           LineHeight="20" />
            </StackPanel>
        </Border>

        <TextBlock Text="· Ppinpix 不会在后台静默上传截图、不会经过开发方中转或记录遥测。"
                   TextWrapping="Wrap"
                   Foreground="#FFA3ABB8"
                   FontSize="12"
                   Margin="0,0,0,4" />
        <TextBlock Text="· 数据将按您自行填写的接口地址和 API 密钥直连发送。"
                   TextWrapping="Wrap"
                   Foreground="#FFA3ABB8"
                   FontSize="12"
                   Margin="0,0,0,14" />

        <CheckBox x:Name="DontShowAgainCheck"
                  Content="我已知晓，后续由我触发翻译时直接发送"
                  IsChecked="True"
                  Foreground="#FFF2F4F7"
                  FontSize="12.5"
                  Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消发送"
                    Padding="14,7"
                    Margin="0,0,10,0"
                    Background="#FF2A2F37"
                    Foreground="#FFF2F4F7"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnCancelClick" />
            <Button Content="确认并开始翻译"
                    Padding="16,7"
                    Background="#FF2F80FF"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
