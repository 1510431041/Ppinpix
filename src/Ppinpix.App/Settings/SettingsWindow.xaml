<Window x:Class="Ppinpix.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ppinpix.App.Settings"
        Title="设置 — Ppinpix"
        Width="900"
        Height="660"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Pp.Settings.WindowBg}"
        Foreground="{DynamicResource Pp.Settings.TextPrimary}"
        FontFamily="{DynamicResource Pp.UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ppinpix.Theme;component/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Pp.Settings.TextPrimary}" />
            </Style>

            <!-- 左侧导航项：图标 + 文字，选中时左侧显示品牌色指示条 -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Pp.Settings.TextPrimary}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Bar"
                                        Width="3"
                                        Height="16"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource Pp.Accent}"
                                        Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pp.Settings.HoverBg}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pp.Settings.NavSelectedBg}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Pp.IconFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Width" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Pp.Settings.TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航 ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource Pp.Settings.CardBg}"
                BorderBrush="{DynamicResource Pp.Settings.CardStroke}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                    <Image Width="28"
                           Height="28"
                           Source="pack://application:,,,/Ppinpix;component/Assets/app.ico"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ppinpix" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="设置" FontSize="12" Foreground="{DynamicResource Pp.Settings.TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="FooterStatusText"
                           DockPanel.Dock="Bottom"
                           Margin="8,10,4,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Pp.Settings.TextSecondary}"
                           Text="更改会自动保存" />

                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBoxItem Tag="General">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                            <TextBlock Text="常规" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Hotkeys">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE765;" />
                            <TextBlock Text="快捷键" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Capture">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE722;" />
                            <TextBlock Text="截图与保存" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Toolbar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE70F;" />
                            <TextBlock Text="截图工具栏" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Pin">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE718;" />
                            <TextBlock Text="贴图" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Ocr">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" />
                            <TextBlock Text="文字识别" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Translate">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE774;" />
                            <TextBlock Text="翻译与模型" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================== 右侧内容 ==================== -->
        <Grid Grid.Column="1" Margin="32,26,12,0">

            <!-- 1. 常规 -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="0,0,20,28">
                    <TextBlock Text="常规" Style="{StaticResource Pp.PageTitle}" />
                    <TextBlock Text="启动方式、界面外观与提示音" Style="{StaticResource Pp.PageSubtitle}" />

                    <TextBlock Text="启动与外观" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="AutoStartCheck" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged">
                                    <StackPanel>
                                        <TextBlock Text="开机自动启动" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="静默驻留在系统托盘，随时按快捷键截图" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <ComboBox x:Name="ThemeCombo"
                                              DockPanel.Dock="Right"
                                              Width="170"
                                              SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="跟随 Windows 系统" Tag="System" />
                                        <ComboBoxItem Content="始终浅色" Tag="Light" />
                                        <ComboBoxItem Content="始终深色" Tag="Dark" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="设置界面主题" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="截图界面固定为深色，不受此项影响" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="AnimationsCheck" Content="界面动画" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <CheckBox x:Name="SoundCheck" Content="截图完成时播放提示音" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="关于与隐私" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <StackPanel>
                                    <TextBlock x:Name="AppVersionText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="20" Style="{StaticResource Pp.RowDesc}">
                                        截图、标注、贴图、取色、OCR 与扫码全部在本地完成，没有遥测，也不会自动联网更新。
                                        <LineBreak />
                                        只有你主动使用「截图翻译」或测试接口时，内容才会直连你自己配置的模型地址。
                                        <LineBreak />
                                        API 密钥与代理密码使用 Windows DPAPI（当前用户）加密保存，不写入明文配置或日志。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <WrapPanel>
                                    <Button Content="打开数据目录" Margin="0,0,8,0" Click="OnOpenAppDataClick" />
                                    <Button Content="打开日志目录" Margin="0,0,8,0" Click="OnOpenLogsClick" />
                                    <Button Content="导出配置备份（已脱敏）" Margin="0,0,8,0" Click="OnExportBackupClick" />
                                    <Button Content="恢复出厂设置"
                                            Style="{StaticResource Pp.Button.Danger}"
                                            Click="OnFactoryResetClick" />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. 快捷键 -->
            <ScrollViewer x:Name="PageHotkeys" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="0,0,20,28">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                VerticalAlignment="Top"
                                Content="恢复默认"
                                Click="OnResetHotkeysClick" />
                        <TextBlock Text="快捷键" Style="{StaticResource Pp.PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="点击输入框后按下组合键；Esc 取消录制，Backspace / Delete 清除。" Style="{StaticResource Pp.PageSubtitle}" />

                    <Border Style="{StaticResource Pp.Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="HkCapture" DockPanel.Dock="Right" />
                                    <TextBlock Text="区域截图" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="HkPinClipboard" DockPanel.Dock="Right" />
                                    <TextBlock Text="把剪贴板内容贴到屏幕" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="HkCaptureOcr" DockPanel.Dock="Right" />
                                    <TextBlock Text="截图并直接识字" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="HkCaptureTranslate" DockPanel.Dock="Right" />
                                    <TextBlock Text="截图并直接翻译" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="HkTogglePins" DockPanel.Dock="Right" />
                                    <TextBlock Text="显示 / 隐藏全部贴图" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <DockPanel>
                                    <local:HotkeyBox x:Name="HkSuspend" DockPanel.Dock="Right" />
                                    <TextBlock Text="暂停 / 恢复全局快捷键" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="HotkeyWarningText"
                               Margin="4,0,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Pp.Danger}"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 3. 截图与保存 -->
            <ScrollViewer x:Name="PageCapture" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="0,0,20,28">
                    <TextBlock Text="截图与保存" Style="{StaticResource Pp.PageTitle}" />
                    <TextBlock Text="选区行为、放大镜，以及图片的保存方式" Style="{StaticResource Pp.PageSubtitle}" />

                    <TextBlock Text="选区与吸附" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <ComboBox x:Name="DelayCombo"
                                              DockPanel.Dock="Right"
                                              Width="140"
                                              SelectionChanged="OnCaptureChanged">
                                        <ComboBoxItem Content="不延迟" Tag="0" />
                                        <ComboBoxItem Content="延迟 1 秒" Tag="1000" />
                                        <ComboBoxItem Content="延迟 2 秒" Tag="2000" />
                                        <ComboBoxItem Content="延迟 3 秒" Tag="3000" />
                                        <ComboBoxItem Content="延迟 5 秒" Tag="5000" />
                                        <ComboBoxItem Content="延迟 10 秒" Tag="10000" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="抓屏延迟" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="用于截取一闪而过的弹出菜单" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="IncludeCursorCheck" Content="截图中包含鼠标指针" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="SnapEnabledCheck" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged">
                                    <StackPanel>
                                        <TextBlock Text="吸附窗口与任务栏边界" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="选区靠近窗口边缘时自动对齐" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="SnapControlsCheck" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged">
                                    <StackPanel>
                                        <TextBlock Text="吸附窗口内部控件" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="通过 UIA 识别按钮、输入框等控件区域" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <DockPanel>
                                    <TextBlock x:Name="SnapThresholdVal" DockPanel.Dock="Right" Style="{StaticResource Pp.ValueText}" />
                                    <Slider x:Name="SnapThresholdSlider"
                                            DockPanel.Dock="Right"
                                            Width="190"
                                            Minimum="0"
                                            Maximum="40"
                                            TickFrequency="2"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnCaptureSliderChanged" />
                                    <TextBlock Text="吸附触发距离" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="放大镜与取色" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="ShowMagnifierCheck" Content="显示像素放大镜" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="HideMagnifierDragCheck" Content="拖拽框选时自动隐藏放大镜" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <TextBlock x:Name="MagZoomVal" DockPanel.Dock="Right" Style="{StaticResource Pp.ValueText}" />
                                    <Slider x:Name="MagZoomSlider"
                                            DockPanel.Dock="Right"
                                            Width="190"
                                            Minimum="2"
                                            Maximum="16"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnCaptureSliderChanged" />
                                    <TextBlock Text="放大镜倍率" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <CheckBox x:Name="ColorRgbCheck" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged">
                                    <StackPanel>
                                        <TextBlock Text="取色默认使用 RGB 格式" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="按 C 复制颜色，Shift 随时切换 RGB / HEX" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="完成与保存" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="CloseOnCopyCheck" Content="复制到剪贴板后立即退出截图" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="CopyAfterSaveCheck" Content="保存文件后同时复制到剪贴板" Checked="OnCaptureChanged" Unchecked="OnCaptureChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <ComboBox x:Name="SaveFormatCombo"
                                              DockPanel.Dock="Right"
                                              Width="190"
                                              SelectionChanged="OnCaptureChanged">
                                        <ComboBoxItem Content="PNG（无损）" Tag="Png" />
                                        <ComboBoxItem Content="JPEG（体积小）" Tag="Jpeg" />
                                        <ComboBoxItem Content="WebP（高压缩）" Tag="Webp" />
                                    </ComboBox>
                                    <TextBlock Text="默认图片格式" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <TextBlock x:Name="QualityVal" DockPanel.Dock="Right" Style="{StaticResource Pp.ValueText}" />
                                    <Slider x:Name="QualitySlider"
                                            DockPanel.Dock="Right"
                                            Width="190"
                                            Minimum="10"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnCaptureSliderChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="有损压缩质量" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="仅对 JPEG / WebP 生效" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <StackPanel>
                                    <TextBlock Text="保存目录" Style="{StaticResource Pp.RowTitle}" Margin="0,0,0,8" />
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="打开" Margin="8,0,0,0" Click="OnOpenSaveDirClick" />
                                        <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseSaveDirClick" />
                                        <TextBox x:Name="SaveDirBox" TextChanged="OnCaptureChanged" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <StackPanel>
                                    <TextBlock Text="文件名模板" Style="{StaticResource Pp.RowTitle}" />
                                    <TextBlock Text="可用变量：{yyyy} {MM} {dd} {HH} {mm} {ss} {w} {h}" Style="{StaticResource Pp.RowDesc}" Margin="0,2,0,8" />
                                    <TextBox x:Name="FileNameTplBox" TextChanged="OnCaptureChanged" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. 截图工具栏 -->
            <ScrollViewer x:Name="PageToolbar" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="0,0,20,28">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                VerticalAlignment="Top"
                                Content="全部显示"
                                Click="OnShowAllToolbarButtonsClick" />
                        <TextBlock Text="截图工具栏" Style="{StaticResource Pp.PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="点击切换按钮的显示与隐藏。隐藏后只是不再占用工具栏位置，对应快捷键仍然可用。"
                               Style="{StaticResource Pp.PageSubtitle}" />

                    <TextBlock Text="标注工具" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}" Padding="16,16,8,8">
                        <WrapPanel>
                            <CheckBox x:Name="TbShowSelectCheck" Content="选择" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowRectangleCheck" Content="矩形" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowEllipseCheck" Content="椭圆" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowArrowCheck" Content="箭头" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowLineCheck" Content="直线" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowFreehandCheck" Content="画笔" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowNumberBadgeCheck" Content="序号" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowTextCheck" Content="文字" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowMosaicCheck" Content="马赛克" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowSpotlightCheck" Content="聚光灯" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowHighlightCheck" Content="荧光笔" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowEraserCheck" Content="橡皮擦" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Text="编辑" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}" Padding="16,16,8,8">
                        <WrapPanel>
                            <CheckBox x:Name="TbShowUndoRedoCheck" Content="撤销 / 重做" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Text="输出与更多" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}" Padding="16,16,8,8">
                        <WrapPanel>
                            <CheckBox x:Name="TbShowLongshotCheck" Content="长截图" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowCopyCheck" Content="复制" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowSaveCheck" Content="保存" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowPinCheck" Content="贴图" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowOcrCheck" Content="文字识别" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                            <CheckBox x:Name="TbShowTranslateCheck" Content="翻译" Style="{StaticResource Pp.Chip}" Checked="OnToolbarVisibilityChanged" Unchecked="OnToolbarVisibilityChanged" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. 贴图 -->
            <ScrollViewer x:Name="PagePin" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="0,0,20,28">
                    <TextBlock Text="贴图" Style="{StaticResource Pp.PageTitle}" />
                    <TextBlock Text="钉在屏幕上的图片窗口的默认行为" Style="{StaticResource Pp.PageSubtitle}" />

                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <TextBlock x:Name="PinOpacityVal" DockPanel.Dock="Right" Style="{StaticResource Pp.ValueText}" />
                                    <Slider x:Name="PinOpacitySlider"
                                            DockPanel.Dock="Right"
                                            Width="190"
                                            Minimum="10"
                                            Maximum="100"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnPinSliderChanged" />
                                    <TextBlock Text="默认不透明度" Style="{StaticResource Pp.RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <TextBlock x:Name="PinMaxVal" DockPanel.Dock="Right" Style="{StaticResource Pp.ValueText}" />
                                    <Slider x:Name="PinMaxSlider"
                                            DockPanel.Dock="Right"
                                            Width="190"
                                            Minimum="1"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnPinSliderChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="贴图数量上限" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="超出后自动关闭最早的一张" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="PinShadowCheck" Content="显示投影与细边框" Checked="OnPinChanged" Unchecked="OnPinChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="PinPixelCheck" Content="尽量保持 1:1 物理像素，保证清晰" Checked="OnPinChanged" Unchecked="OnPinChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="PinRestoreCheck" Content="下次启动时恢复未关闭的贴图" Checked="OnPinChanged" Unchecked="OnPinChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <CheckBox x:Name="PinTextSelectCheck" Checked="OnPinChanged" Unchecked="OnPinChanged">
                                    <StackPanel>
                                        <TextBlock Text="在贴图上划词复制（离线 OCR）" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="按住空格可暂时穿透，拖动窗口" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 6. 文字识别 -->
            <ScrollViewer x:Name="PageOcr" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="0,0,20,28">
                    <TextBlock Text="文字识别" Style="{StaticResource Pp.PageTitle}" />
                    <TextBlock Text="本地识别文字与二维码，全程不联网" Style="{StaticResource Pp.PageSubtitle}" />

                    <TextBlock Text="识别引擎" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <DockPanel>
                                    <ComboBox x:Name="OcrEngineCombo"
                                              DockPanel.Dock="Right"
                                              Width="250"
                                              SelectionChanged="OnOcrChanged">
                                        <ComboBoxItem Content="RapidOCR 本地引擎（ONNX）" Tag="RapidOcr" />
                                        <ComboBoxItem Content="Windows 系统内置 OCR" Tag="WindowsSystem" />
                                    </ComboBox>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="首选引擎" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="模型未就绪时会自动回退" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <StackPanel>
                                    <TextBlock Text="优先语言" Style="{StaticResource Pp.RowTitle}" />
                                    <TextBlock Text="用逗号分隔，例如 zh-Hans-CN, en-US" Style="{StaticResource Pp.RowDesc}" Margin="0,2,0,8" />
                                    <TextBox x:Name="OcrLangsBox" TextChanged="OnOcrChanged" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row}">
                                <CheckBox x:Name="DetectBarcodesCheck" Content="识别文字时同时检测二维码与条形码" Checked="OnOcrChanged" Unchecked="OnOcrChanged" />
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <DockPanel>
                                    <TextBlock x:Name="OcrIdleVal" DockPanel.Dock="Right" Style="{StaticResource Pp.ValueText}" Width="72" />
                                    <Slider x:Name="OcrIdleSlider"
                                            DockPanel.Dock="Right"
                                            Width="190"
                                            Minimum="0"
                                            Maximum="60"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnOcrSliderChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="闲置后卸载模型" Style="{StaticResource Pp.RowTitle}" />
                                        <TextBlock Text="释放内存，下次识别时自动重新加载" Style="{StaticResource Pp.RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="模型状态" Style="{StaticResource Pp.GroupTitle}" />
                    <Border Style="{StaticResource Pp.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Pp.Row}">
                                <StackPanel>
                                    <TextBlock x:Name="OcrModelStatusText" Style="{StaticResource Pp.RowDesc}" Margin="0" />
                                    <TextBlock x:Name="SystemOcrLangsText" Style="{StaticResource Pp.RowDesc}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pp.Row.Last}">
                                <WrapPanel>
                                    <Button Content="打开自定义模型目录" Margin="0,0,8,0" Click="OnOpenModelsDirClick" />
                                    <Button Content="立即卸载内存中的模型" Click="OnUnloadOcrClick" />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 7. 翻译与大模型 -->
            <Grid x:Name="PageTranslate" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="翻译与模型" Style="{StaticResource Pp.PageTitle}" />
                    <TextBlock Text="配置你自己的大模型接口，密钥仅保存在本机" Style="{StaticResource Pp.PageSubtitle}" />
                </StackPanel>
                <local:TranslateSettingsPanel x:Name="TranslatePanel" Grid.Row="1" Margin="0,0,20,16" />
            </Grid>
        </Grid>
    </Grid>
</Window>
