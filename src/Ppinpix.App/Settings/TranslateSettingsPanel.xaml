<UserControl x:Class="Ppinpix.App.Settings.TranslateSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：配置档案列表与导出/导入 -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Button Content="新增" Margin="0,0,3,0" Padding="4,0" Click="OnAddProfileClick" />
                    <Button Content="复制" Margin="2,0,2,0" Padding="4,0" Click="OnCloneProfileClick" />
                    <Button Content="删除" Margin="3,0,0,0" Padding="4,0" Click="OnDeleteProfileClick" />
                </UniformGrid>
                <UniformGrid Columns="2">
                    <Button Content="导出 JSON" Margin="0,0,3,0" Padding="4,0" Style="{DynamicResource Pp.Button.Ghost}" Click="OnExportProfilesClick" />
                    <Button Content="导入 JSON" Margin="3,0,0,0" Padding="4,0" Style="{DynamicResource Pp.Button.Ghost}" Click="OnImportProfilesClick" />
                </UniformGrid>
            </StackPanel>

            <ListBox x:Name="ProfileListBox" SelectionChanged="OnProfileSelected" />
        </DockPanel>

        <!-- 右侧：当前选中配置编辑区 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,16">
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="SetDefaultBtn"
                            DockPanel.Dock="Right"
                            Content="设为默认配置"
                            Click="OnSetDefaultClick" />
                    <TextBlock Text="接口配置"
                               Style="{DynamicResource Pp.RowTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Border Style="{DynamicResource Pp.Card}" Padding="16,14,16,16">
                    <StackPanel>
                        <TextBlock Text="配置名称" Style="{DynamicResource Pp.RowDesc}" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" TextChanged="OnFieldChanged" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="协议类型" Style="{DynamicResource Pp.RowDesc}" Margin="0,0,0,4" />
                                <ComboBox x:Name="ProtocolCombo" SelectionChanged="OnFieldChanged">
                                    <ComboBoxItem Content="OpenAI 兼容" Tag="OpenAiCompatible" />
                                    <ComboBoxItem Content="Anthropic Messages" Tag="AnthropicMessages" />
                                    <ComboBoxItem Content="Google Gemini" Tag="Gemini" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="翻译默认呈现" Style="{DynamicResource Pp.RowDesc}" Margin="0,0,0,4" />
                                <ComboBox x:Name="PresentationCombo" SelectionChanged="OnGlobalTranslateChanged">
                                    <ComboBoxItem Content="原位覆盖贴图（默认）" Tag="Overlay" />
                                    <ComboBoxItem Content="对照浮窗" Tag="Compare" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="接口地址（Base URL）" Style="{DynamicResource Pp.RowDesc}" Margin="0,12,0,4" />
                        <TextBox x:Name="BaseUrlBox" TextChanged="OnFieldChanged" />
                        <CheckBox x:Name="AutoAppendCheck"
                                  Margin="0,4,0,0"
                                  Content="自动补全接口路径（如 /chat/completions）"
                                  Checked="OnFieldChanged"
                                  Unchecked="OnFieldChanged" />

                        <TextBlock Text="模型名称" Style="{DynamicResource Pp.RowDesc}" Margin="0,8,0,4" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="FetchModelsBtn"
                                    DockPanel.Dock="Right"
                                    Content="拉取模型"
                                    Margin="8,0,0,0"
                                    Click="OnFetchModelsClick" />
                            <ComboBox x:Name="ModelCombo"
                                      IsEditable="True"
                                      LostFocus="OnFieldChanged"
                                      SelectionChanged="OnFieldChanged" />
                        </DockPanel>

                        <TextBlock Text="API 密钥（DPAPI 本机加密存储）" Style="{DynamicResource Pp.RowDesc}" Margin="0,12,0,4" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="RevealKeyBtn"
                                    DockPanel.Dock="Right"
                                    Content="显示密钥"
                                    Margin="8,0,0,0"
                                    Click="OnToggleRevealKeyClick" />
                            <Grid>
                                <PasswordBox x:Name="ApiKeyPwdBox" PasswordChanged="OnApiKeyChanged" />
                                <TextBox x:Name="ApiKeyPlainBox" Visibility="Collapsed" IsReadOnly="True" />
                            </Grid>
                        </DockPanel>

                        <DockPanel Margin="0,14,0,0">
                            <Button x:Name="TestConnBtn"
                                    DockPanel.Dock="Left"
                                    Content="测试连接"
                                    Padding="18,0"
                                    Style="{DynamicResource Pp.Button.Primary}"
                                    Click="OnTestConnectionClick" />
                            <TextBlock x:Name="TestStatusText"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource Pp.RowDesc}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Pp.Card}" Padding="16,14,16,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="默认输入方式" Style="{DynamicResource Pp.RowDesc}" Margin="0,0,0,4" />
                                <ComboBox x:Name="InputModeCombo" SelectionChanged="OnFieldChanged">
                                    <ComboBoxItem Content="先本地 OCR 再翻译文字" Tag="OcrThenTranslate" />
                                    <ComboBoxItem Content="直接发送图片（需多模态）" Tag="ImageDirectly" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="SupportsVisionCheck"
                                      Grid.Column="2"
                                      VerticalAlignment="Bottom"
                                      Content="模型支持图片输入"
                                      Checked="OnFieldChanged"
                                      Unchecked="OnFieldChanged" />
                        </Grid>

                        <!-- 代理与高级参数 -->
                        <Expander Header="网络代理与高级参数" Margin="0,10,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ProxyModeCombo" Grid.Column="0" SelectionChanged="OnFieldChanged">
                                        <ComboBoxItem Content="跟随系统代理" Tag="System" />
                                        <ComboBoxItem Content="直连（不用代理）" Tag="None" />
                                        <ComboBoxItem Content="HTTP 代理" Tag="Http" />
                                        <ComboBoxItem Content="SOCKS5 代理" Tag="Socks5" />
                                    </ComboBox>
                                    <TextBox x:Name="ProxyHostBox" Grid.Column="2" ToolTip="代理主机 IP 或域名" TextChanged="OnFieldChanged" />
                                    <TextBox x:Name="ProxyPortBox" Grid.Column="4" ToolTip="端口" TextChanged="OnFieldChanged" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ProxyUserBox" Grid.Column="0" ToolTip="代理用户名（可选）" TextChanged="OnFieldChanged" />
                                    <PasswordBox x:Name="ProxyPwdBox" Grid.Column="2" ToolTip="代理密码（可选，DPAPI 加密）" PasswordChanged="OnProxyPwdChanged" />
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Temperature" Style="{DynamicResource Pp.RowDesc}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TempBox" TextChanged="OnFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="超时（秒）" Style="{DynamicResource Pp.RowDesc}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TimeoutBox" TextChanged="OnFieldChanged" />
                                    </StackPanel>
                                    <CheckBox x:Name="StreamCheck"
                                              Grid.Column="4"
                                              VerticalAlignment="Bottom"
                                              Content="流式输出"
                                              Checked="OnFieldChanged"
                                              Unchecked="OnFieldChanged" />
                                </Grid>

                                <TextBlock Text="自定义提示词（留空使用内置；可用 {source_lang} {target_lang} {text}）"
                                           Style="{DynamicResource Pp.RowDesc}"
                                           Margin="0,12,0,4" />
                                <TextBox x:Name="PromptBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         MinHeight="72"
                                         Height="72"
                                         TextChanged="OnFieldChanged" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
